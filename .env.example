# Oscar CTA-backend — omgevingsvariabelen
# Bij opstarten afgedwongen (instrumentation.ts). Een app die zonder deze
# waarden start en pas later crasht, valt te laat op.

# VERPLICHT — Postgres met onze eigen tabellen: locaties, instellingen,
# signalen en de CTA-log. De POS-, device- en CTA-tabellen van WaiterPro staan
# hier niet in; die worden via de adapters gelezen.
DATABASE_URL="postgresql://user:wachtwoord@localhost:5432/oscar_cta"

# VERPLICHT — welke implementatie van de adapters draait.
#   mock       de mock-tabellen uit schema.prisma, voor demo zonder koppeling
#   waiterpro  de echte tabellen
ADAPTERS="mock"

# OPTIONEEL — zet demo-data klaar in een lege database. In productie uit.
SEED_DEMODATA="false"
