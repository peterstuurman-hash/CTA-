{
  "name": "oscar-cta",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @oscar/db exec prisma generate",
    "db:migrate": "pnpm --filter @oscar/db exec prisma migrate dev",
    "db:studio": "pnpm --filter @oscar/db exec prisma studio",
    "proefrit": "pnpm --filter @oscar/backend proefrit"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
